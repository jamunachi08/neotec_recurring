{
 "doctype": "DocType",
 "name": "Recurring Entry Line",
 "module": "Neotec Recurring",
 "istable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "field_order": [
  "account",
  "entry_type",
  "allocation_type",
  "percentage",
  "fixed_amount",
  "party_section",
  "party_type",
  "party",
  "column_break_party",
  "account_type_display",
  "dimension_section",
  "cost_center",
  "project",
  "remark_section",
  "user_remark"
 ],
 "fields": [
  {
   "fieldname": "account",
   "fieldtype": "Link",
   "label": "Account",
   "options": "Account",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "entry_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Debit\nCredit",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "allocation_type",
   "fieldtype": "Select",
   "label": "Allocation",
   "options": "Balancing\nPercentage\nFixed Amount",
   "default": "Balancing",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "percentage",
   "fieldtype": "Float",
   "label": "Percentage",
   "default": "100",
   "depends_on": "eval:doc.allocation_type=='Percentage'",
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "fixed_amount",
   "fieldtype": "Currency",
   "label": "Fixed Amount",
   "depends_on": "eval:doc.allocation_type=='Fixed Amount'",
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "party_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "party_type",
   "fieldtype": "Link",
   "label": "Party Type",
   "options": "Party Type",
   "description": "Leave blank to resolve from the account type. Receivable resolves to Customer, Payable to Supplier."
  },
  {
   "fieldname": "party",
   "fieldtype": "Dynamic Link",
   "label": "Party",
   "options": "party_type"
  },
  {
   "fieldname": "column_break_party",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "account_type_display",
   "fieldtype": "Data",
   "label": "Account Type",
   "read_only": 1,
   "fetch_from": "account.account_type"
  },
  {
   "fieldname": "dimension_section",
   "fieldtype": "Section Break",
   "label": "Dimensions",
   "collapsible": 1
  },
  {
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "label": "Cost Center",
   "options": "Cost Center"
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Project",
   "options": "Project"
  },
  {
   "fieldname": "remark_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "user_remark",
   "fieldtype": "Small Text",
   "label": "Remark"
  }
 ],
 "permissions": []
}
