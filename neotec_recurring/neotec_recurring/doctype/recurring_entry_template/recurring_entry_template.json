  "final_posting_basis",
  "auto_submit",
  "post_ahead_days",
  "user_remark",
  "posting_section",
  "voucher_type",
  "je_naming_series",
  "column_break_post",
  "is_provision",
  "auto_reverse",
  "reversal_offset_days",
  "derived_section",
  "term_days_actual",
  "first_period_days",
  "occurrences_display",
  "schedule_section",
  "schedule",
  "amended_from",
  "covers_from",
  "repeat_every_count",
  "repeat_every_unit",
  "continue_for_count",
  "continue_for_unit",
  "day_adjustment",
  "term_inclusive",
  "ends_on_days",
  "last_posting_date"
 ],
 "permissions": [
  {
   "role": "Accounts Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "email": 1,
   "share": 1,
   "print": 1
  },
  {
   "role": "Accounts User",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "report": 1,
   "export": 1,
   "email": 1,
   "share": 1,
   "print": 1
  }
 ]
